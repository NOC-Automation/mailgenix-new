# Local development configuration - SQLite
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=mailgenix-local-development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# SQLite
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Optional local-only safety switch for future email integration
APP_ENV=local
EMAIL_SENDING_ENABLED=False
